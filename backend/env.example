# ── Cloud Ollama (indexing only) ───────────────────────────────
OLLAMA_CLOUD_URL=https://api.ollama.com
OLLAMA_CLOUD_API_KEY=your_ollama_cloud_api_key_here
OLLAMA_CLOUD_MODEL=llama3.2-vision

# ── Local Ollama (answering user questions) ────────────────────
OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_LOCAL_MODEL=llama3.2-vision
